{
  "permissions": {
    "allow": [
      "mcp__pencil"
    ]
  },
  "model": "opus[1m]",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "test -f \"$HOME/.claude/hooks/herdr-agent-state.sh\" && bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session || true",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "command -v gh-axi >/dev/null && gh-axi || true",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "command -v chrome-devtools-axi >/dev/null && chrome-devtools-axi || true",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "command -v lavish-axi >/dev/null && lavish-axi || true",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "input=$(cat); model=$(echo \"$input\" | jq -r '.model.display_name'); used=$(echo \"$input\" | jq -r '.context_window.used_percentage // empty'); if [ -n \"$used\" ]; then printf '\\033[2m%s\\033[0m \\033[2m|\\033[0m \\033[2mContext: %.0f%% used\\033[0m' \"$model\" \"$used\"; else printf '\\033[2m%s\\033[0m' \"$model\"; fi"
  },
  "effortLevel": "low",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "low"
    }
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark"
}
